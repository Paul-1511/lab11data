# Copie este archivo a .env (está en .gitignore) solo si necesita cambiar algo. No contiene credenciales.

# Carpeta del equipo con la fuente de datos; se monta en /data, solo lectura.
# Por defecto ./data (incluye data/synthetic/base_sintetica.csv). Para los datos institucionales
# indique la carpeta que contiene el Excel, con barras normales: LAB11_DATA_DIR=D:/datos/institucional
LAB11_DATA_DIR=./data

# Puertos locales (solo se publican en 127.0.0.1)
LAB11_STREAMLIT_PORT=8501
LAB11_MLFLOW_PORT=5000
